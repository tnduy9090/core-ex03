```cshtml
@model ex03.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<!-- Ưu đãi -->
<section class="top-discount-area d-md-flex align-items-center">
    <div class="single-discount-area">
        <h5>Miễn phí vận chuyển</h5>
        <h6>Áp dụng theo chương trình</h6>
    </div>

    <div class="single-discount-area">
        <h5>Sản phẩm chất lượng</h5>
        <h6>Mua sắm ngay hôm nay</h6>
    </div>
</section>

<!-- Breadcrumb -->
<div class="breadcumb_area">
    <div class="container">
        <ol class="breadcrumb d-flex align-items-center">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            </li>

            <li class="breadcrumb-item">
                @(Model.Category?.Name ?? "Danh mục")
            </li>

            <li class="breadcrumb-item active">
                @Model.Name
            </li>
        </ol>

        <a asp-controller="Home"
           asp-action="Index"
           class="backToHome d-block">
            <i class="fa fa-angle-double-left"></i>
            Quay lại trang chủ
        </a>
    </div>
</div>

<!-- Chi tiết sản phẩm -->
<section class="single_product_details_area section_padding_0_100">
    <div class="container">
        <div class="row">

            <!-- Ảnh -->
            <div class="col-12 col-md-6">
                <div class="single_product_thumb">
                    @if (!string.IsNullOrWhiteSpace(Model.Image))
                    {
                        var imageUrl = Model.Image.StartsWith("/")
                            ? Model.Image
                            : Url.Content("~/images/products/" + Model.Image);

                        <img src="@imageUrl"
                             alt="@Model.Name"
                             class="img-fluid"
                             style="width:100%; max-height:500px; object-fit:contain;" />
                    }
                    else
                    {
                        <div class="alert alert-secondary">
                            Sản phẩm chưa có hình ảnh.
                        </div>
                    }
                </div>
            </div>

            <!-- Thông tin -->
            <div class="col-12 col-md-6">
                <div class="single_product_desc">

                    <h4 class="title">@Model.Name</h4>

                    <h4 class="price">
                        @Model.Price.ToString("N0") VNĐ
                    </h4>

                    <p>
                        Danh mục:
                        <strong>
                            @(Model.Category?.Name ?? "Chưa phân loại")
                        </strong>
                    </p>

                    <p>
                        Số lượng còn:
                        <strong>@Model.Quantity</strong>
                    </p>

                    <hr />

                    <h6>Mô tả sản phẩm</h6>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    else
                    {
                        <p>Chưa có mô tả cho sản phẩm này.</p>
                    }

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-secondary mt-3">
                        Tiếp tục mua sắm
                    </a>

                </div>
            </div>

        </div>
    </div>
</section>
```