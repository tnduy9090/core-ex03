<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - Karl Fashion</title>

    <!-- Favicon -->
    <link rel="icon" href="~/client/img/core-img/favicon.ico">

    <!-- CSS của giao diện Karl -->
    <link rel="stylesheet" href="~/client/css/core-style.css">
    <link rel="stylesheet" href="~/client/style.css">
    <link rel="stylesheet" href="~/client/css/responsive.css">

    @RenderSection("Styles", required: false)
</head>

<body>
    <!-- Side Transition Area (Menu trượt bên của Karl) -->
    <div class="catagories-side-menu">
        <!-- Lấy từ phần side menu trong index.html -->
        <div id="sideMenuClose"><i class="ti-close"></i></div>
        <div class="nav-side-menu">
            <div class="menu-list">
                <h6>Danh mục</h6>
                <ul id="menu-content" class="menu-content collapse out">
                    <!-- Danh mục sản phẩm động -->
                </ul>
            </div>
        </div>
    </div>

    <div id="wrapper">
            @await Html.PartialAsync("_HeaderPartial")
        </header>

        <!-- NỘI DUNG THAY ĐỔI CỦA CÁC TRANG -->
        <main role="main">
            @RenderBody()
        </main>

        <!-- FOOTER AREA -->
    <footer class="footer_area">
        @await Html.PartialAsync("_FooterPartial")
    </footer>
	</div>

    <!-- SCRIPTS của giao diện Karl (Đúng thứ tự load script) -->
    <script src="~/client/js/jquery/jquery-2.2.4.min.js"></script>
    <script src="~/client/js/popper.min.js"></script>
    <script src="~/client/js/bootstrap.min.js"></script>
    <script src="~/client/js/plugins.js"></script>
    <script src="~/client/js/active.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>