@model ex03.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container-fluid">

    <h2>Chỉnh sửa sản phẩm</h2>

    <hr />

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden"
               asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="form-group">
            <label asp-for="Name">
                Tên sản phẩm
            </label>

            <input asp-for="Name"
                   class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>
        </div>

        <br />

        <div class="form-group">
            <label asp-for="Price">
                Giá
            </label>

            <input asp-for="Price"
                   type="number"
                   class="form-control" />
        </div>

        <br />

        <div class="form-group">
            <label asp-for="Quantity">
                Số lượng
            </label>

            <input asp-for="Quantity"
                   type="number"
                   class="form-control" />
        </div>

        <br />

        <div class="form-group">
            <label>
                Danh mục
            </label>

            <select asp-for="CategoryId"
                    asp-items="ViewBag.CategoryId"
                    class="form-control">
            </select>
        </div>

        <br />

        <div class="form-group">
            <label asp-for="Description">
                Mô tả
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="4">
            </textarea>
        </div>

        <br />

        <!-- Ảnh hiện tại -->
        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <div class="form-group">

                <label>Ảnh hiện tại</label>

                <br />

                <img src="@Model.Image"
                     style="width:150px;height:150px;object-fit:cover;"
                     class="img-thumbnail" />

            </div>

            <br />
        }

        <!-- Upload ảnh mới -->
        <div class="form-group">

            <label>
                Chọn ảnh mới
            </label>

            <input type="file"
                   name="imageFile"
                   class="form-control"
                   accept="image/*" />

            <small class="text-muted">
                Nếu không chọn ảnh mới thì ảnh cũ được giữ nguyên.
            </small>

        </div>

        <br />

        <button type="submit"
                class="btn btn-warning">
            Lưu thay đổi
        </button>

        <a asp-action="Index"
           class="btn btn-default">
            Quay lại
        </a>

    </form>

</div>