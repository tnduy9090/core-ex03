@model ex03.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="container-fluid">

    <h1 class="page-header">Thêm sản phẩm</h1>

    <div class="panel panel-default">

        <div class="panel-heading">
            <strong>Thông tin sản phẩm</strong>
        </div>

        <div class="panel-body">

            <form asp-area="Admin"
                  asp-controller="Product"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <!-- Tên -->
                <div class="form-group">
                    <label asp-for="Name">
                        Tên sản phẩm
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Nhập tên sản phẩm" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <br />

                <!-- Giá -->
                <div class="form-group">
                    <label asp-for="Price">
                        Giá
                    </label>

                    <input asp-for="Price"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control"
                           placeholder="Nhập giá" />

                    <span asp-validation-for="Price"
                          class="text-danger">
                    </span>
                </div>

                <br />

                <!-- Số lượng -->
                <div class="form-group">
                    <label asp-for="Quantity">
                        Số lượng
                    </label>

                    <input asp-for="Quantity"
                           type="number"
                           min="0"
                           class="form-control"
                           placeholder="Nhập số lượng" />

                    <span asp-validation-for="Quantity"
                          class="text-danger">
                    </span>
                </div>

                <br />

                <!-- Danh mục -->
                <div class="form-group">

                    <label asp-for="CategoryId">
                        Danh mục
                    </label>

                    <select asp-for="CategoryId"
                            asp-items="ViewBag.CategoryId"
                            class="form-control">

                        <option value="">
                            -- Chọn danh mục --
                        </option>

                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger">
                    </span>

                </div>

                <br />

                <!-- Mô tả -->
                <div class="form-group">

                    <label asp-for="Description">
                        Mô tả
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Nhập mô tả">
                    </textarea>

                </div>

                <br />

                <!-- Ảnh -->
                <div class="form-group">

                    <label>
                        Hình ảnh
                    </label>

                    <input type="file"
                           name="imageFile"
                           class="form-control"
                           accept="image/*" />

                </div>

                <br />

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa fa-plus"></i>
                    Thêm sản phẩm

                </button>

                <a asp-area="Admin"
                   asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-default">

                    Quay lại

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}